{
  "expo": {
    "name": "Fit Center",
    "slug": "fitcenter-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#151515",
      "image": "./src/assets/logo.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.fitcenter.app",
      "adaptiveIcon": {
        "backgroundColor": "#151515"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitcenter.app"
    }
  }
}
